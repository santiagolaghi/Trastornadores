{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/supabase-lite.js",
      "destination": "https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.117.1/dist/umd/supabase.min.js"
    },
    {
      "source": "/api/lista/import-analyze",
      "destination": "https://lista-sabados.vercel.app/api/import-analyze"
    },
    {
      "source": "/api/lista/push-subscribe",
      "destination": "https://lista-sabados.vercel.app/api/push-subscribe"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        },
        {
          "key": "X-TNT-Deployment",
          "value": "team-experience-2026-10-04"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/supabase-lite.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ],
  "buildCommand": "mkdir -p public && cp -r assets admin asistencia buffet campamento chat efe glosario icons organizacion lista-sabados perfiles manifest.webmanifest index.html sw.js __tnt-review__ public/",
  "outputDirectory": "public",
  "installCommand": "echo skip-install"
}
