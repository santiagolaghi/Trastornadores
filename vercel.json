{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/supabase-lite.js",
      "destination": "https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.117.1/dist/umd/supabase.min.js"
    },
    {
      "source": "/api/lista/import-analyze",
      "destination": "https://lista-sabados.vercel.app/api/import-analyze"
    },
    {
      "source": "/api/lista/push-subscribe",
      "destination": "https://lista-sabados.vercel.app/api/push-subscribe"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        },
        {
          "key": "X-TNT-Deployment",
          "value": "neobrutal-2026-10-07-profiles"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/supabase-lite.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ],
  "buildCommand": "mkdir -p public && cp -r assets admin asistencia buffet campamento chat efe glosario icons organizacion lista-sabados perfiles manifest.webmanifest index.html sw.js public/ && python -c \"from pathlib import Path; p=Path('public/buffet/index.html'); s=p.read_text(); s=s.replace('/assets/tnt-experience.js?v=2','/assets/tnt-experience.js?v=65'); s=s.replace('<script type=\\\"module\\\">','<script src=\\\"/assets/tnt-buffet-direct.js?v=1\\\"></script><script type=\\\"module\\\">',1); p.write_text(s)\"",
  "outputDirectory": "public",
  "installCommand": "echo skip-install"
}
