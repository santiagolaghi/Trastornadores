{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/efe/auth", "destination": "https://lista-efe.vercel.app/api/auth" },
    { "source": "/api/efe/sync", "destination": "https://lista-efe.vercel.app/api/sync" },
    { "source": "/api/lista/sync", "destination": "https://lista-sabados.vercel.app/api/sync" },
    { "source": "/api/lista/import-analyze", "destination": "https://lista-sabados.vercel.app/api/import-analyze" },
    { "source": "/api/lista/push-subscribe", "destination": "https://lista-sabados.vercel.app/api/push-subscribe" }
  ],
  "headers": [
    { "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }] }
  ]
}
